        "@fontsource-variable/geist": "^5.3.0",
        "@hookform/resolvers": "^5.9.2",
        "@tanstack/react-query": "^5.105.0",
        "axios": "^1.21.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "lucide-react": "^1.62.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-router": "^8.5.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    }
