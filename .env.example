APP_NAME=CHMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Churches live on {slug}.{TENANT_BASE_DOMAIN}. Locally "localhost" gives demo.localhost.
# Production must set the real platform domain (env:check refuses "localhost").
TENANT_BASE_DOMAIN=localhost

# --- Logging -----------------------------------------------------------------
# Production: LOG_STACK=daily, LOG_LEVEL=warning, LOG_FORMAT=json (docs/17).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_FORMAT=default

# --- Database (PostgreSQL) ---------------------------------------------------
# scripts/setup-dev-db.sh creates this role and the chms / chms_test databases from these values.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chms
DB_USERNAME=chms
DB_PASSWORD=

# --- Sessions and cookies ----------------------------------------------------
# SESSION_DOMAIN stays null: cookies are host-only so a session never reaches another church (D-027).
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset: every church subdomain is treated as a first-party app host.
# SANCTUM_STATEFUL_DOMAINS=

# --- Queues, cache, Redis ----------------------------------------------------
# Workers: php artisan queue:work redis --queue=critical,payments,notifications,reports,exports,scheduled
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Files -------------------------------------------------------------------
# "local" for development. Staging and production use the object-storage disk (r2).
FILESYSTEM_DISK=local

# Cloudflare R2 (staging and production). The endpoint is https://<account id>.r2.cloudflarestorage.com.
# Backups use a separate bucket and a separate key pair.
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_BACKUP_ACCESS_KEY_ID=
CLOUDFLARE_R2_BACKUP_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BACKUP_BUCKET=

# --- SMS ---------------------------------------------------------------------
# log = write messages to the local log (development only; env:check rejects it elsewhere).
SMS_PRIMARY_PROVIDER=log

# --- Health check ------------------------------------------------------------
HEALTH_MIN_FREE_DISK_PERCENT=10

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
